[Unit]
Description=Swift-Guard Packet Processing Framework
Documentation=https://github.com/uni2u/swift-guard
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/swift-guard-daemon --bpf-obj /usr/local/lib/swift-guard/xdp_filter.o
Restart=on-failure
RestartSec=5s

# API socket directory: /run/swift-guard (0755). The daemon creates
# /run/swift-guard/api.sock as root:swift-guard 0660 (root-only 0600 if the group is missing).
RuntimeDirectory=swift-guard
RuntimeDirectoryMode=0755

# Security settings
# CAP_CHOWN: needed to set the API socket group to swift-guard
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_CHOWN
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
# MemoryDenyWriteExecute is not set: wasmtime JIT needs W^X-violating mappings

[Install]
WantedBy=multi-user.target
